# Base path for the Souqy backend. In dev this is proxied by Vite to the .NET API
# (see vite.config.ts) so the browser never hits a cross-origin URL (no CORS needed).
VITE_API_URL=/api/v1

# Where the Vite dev proxy forwards /api requests.
#   - Real backend (Souqy_Backend, `dotnet run`):  http://localhost:5072
#   - Local mock server (`npm run mock`):          http://localhost:5072  (same port on purpose)
VITE_PROXY_TARGET=http://localhost:5072

# Set to "true" to skip the network completely and use the in-memory mock data
# (handy for UI work when neither the backend nor the mock server is running).
VITE_USE_MOCK=false
